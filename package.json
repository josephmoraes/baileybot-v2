{
  "name": "baileybot-v2",
  "version": "2.0.0",
  "description": "Plataforma local para gestão de clientes, campanhas, mensagens e comissões via WhatsApp.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,css,html}\"",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "campaigns",
    "crm",
    "sqlite",
    "express"
  ],
  "author": "Joseph Moraes",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "protobufjs@7.6.5": true,
    "better-sqlite3@12.11.1": true,
    "@whiskeysockets/baileys@7.0.0-rc14": true
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5"
  }
}
